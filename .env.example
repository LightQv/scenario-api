# App Configuration
APP_NAME="Scenario API"
APP_VERSION="2.0.0"
DEBUG=true

# CORS Configuration
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration
DATABASE_URL="postgresql://scenario_user:scenario_password@localhost:5432/scenario_db"
POSTGRES_DB=scenario_example_db
POSTGRES_USER=scenario_example_user
POSTGRES_PASSWORD=scenario_example_strong_password
POSTGRES_HOST=host_example

# Database restore
DB_CONTAINER_NAME=scenario-postgres-dev

# JWT Configuration
JWT_SECRET_KEY="your_super_secret_jwt_key_change_this_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRES_IN=43200

# SMTP Configuration for emails
MAIL_SERVICE="your_email@email.com"
MAIL_FROM="your_email@email.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_smtp_token"
SMTP_PASSWORD="your_app_password"
SMTP_USE_TLS=true

# Media server integrations
TMDB_API_TOKEN="example_tmdb_api_token"
RADARR_URL="http://radarr.example.local:7878"
RADARR_API_KEY="example_radarr_api_key"
RADARR_WEBHOOK_SECRET="example_radarr_webhook_secret"
RADARR_ROOT_FOLDER_PATH="/movies"
RADARR_QUALITY_PROFILE_ID=1
SONARR_URL="http://sonarr.example.local:8989"
SONARR_API_KEY="example_sonarr_api_key"
SONARR_WEBHOOK_SECRET="example_sonarr_webhook_secret"
SONARR_ROOT_FOLDER_PATH="/tv"
SONARR_ANIME_ROOT_FOLDER_PATH="/anime"
SONARR_QUALITY_PROFILE_ID=2
SONARR_ON_AIR_QUALITY_PROFILE_ID=2
SONARR_COMPLETE_QUALITY_PROFILE_ID=7
SONARR_ANIME_QUALITY_PROFILE_ID=1
SONARR_LANGUAGE_PROFILE_ID=1
SONARR_ANIME_LANGUAGE_PROFILE_ID=2
SONARR_SERIES_TYPE="standard"
SONARR_ANIME_SERIES_TYPE="anime"
SONARR_MONITOR_MODE="all"
SONARR_ON_AIR_RECENCY_DAYS=21
SONARR_SEASON_FOLDER=true
SONARR_ANIME_TAG_LABEL="anime"
SONARR_ON_AIR_TAG_LABEL="tv-onair"
SONARR_COMPLETE_TAG_LABEL="tv-complete"
SONARR_USE_ANIME_SERIES_TYPE=true
OWNED_MEDIA_AUTO_SYNC_ENABLED=false
OWNED_MEDIA_SYNC_HOURS=[0,6,12,18]
OWNED_MEDIA_SYNC_TIMEZONE="Europe/Paris"
INTEGRATION_SETTINGS_ENCRYPTION_KEY="generate_with_python_cryptography_fernet"

# Security Settings
PASSWORD_MIN_LENGTH=7
PASSWORD_MAX_LENGTH=30
USERNAME_MIN_LENGTH=5
USERNAME_MAX_LENGTH=30
