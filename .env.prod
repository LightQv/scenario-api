# App Configuration
APP_NAME="Scenario API"
APP_VERSION="2.0.0"
APP_PORT=8000
DEBUG=false

# CORS Configuration
FRONTEND_URL="https://yourdomain.com"
ALLOWED_ORIGINS=["https://yourdomain.com"]

# Database Configuration
DATABASE_URL="postgresql://scenario_prod_user:scenario_prod_strong_password@scenario-postgres:5432/scenario_prod_db"
POSTGRES_DB=scenario_prod_db
POSTGRES_USER=scenario_prod_user
POSTGRES_PASSWORD=scenario_prod_strong_password
POSTGRES_HOST=host_prod

# JWT Configuration
JWT_SECRET_KEY="your_production_super_secret_jwt_key_very_long_and_secure"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRES_IN=43200

# SMTP Configuration for emails
MAIL_SERVICE="your_email@email.com"
MAIL_FROM="your_email@email.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_smtp_token"
SMTP_PASSWORD="your_app_password"
SMTP_USE_TLS=true

# Media server integrations
TMDB_API_TOKEN="example_prod_tmdb_api_token"
SONARR_ON_AIR_RECENCY_DAYS=21
OWNED_MEDIA_AUTO_SYNC_ENABLED=false
OWNED_MEDIA_SYNC_HOURS=[0,6,12,18]
OWNED_MEDIA_SYNC_TIMEZONE="Europe/Paris"
INTEGRATION_SETTINGS_ENCRYPTION_KEY="generate_with_python_cryptography_fernet"

# Security Settings
PASSWORD_MIN_LENGTH=7
PASSWORD_MAX_LENGTH=30
USERNAME_MIN_LENGTH=5
USERNAME_MAX_LENGTH=30
